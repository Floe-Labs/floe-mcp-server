{
  "name": "@floelabs/mcp-server",
  "mcpName": "io.github.floe-labs/payments",
  "version": "0.4.1",
  "description": "MCP server for Floe — trusted settlement for task-based AI: reconcile per-task and per-outcome AI vendor invoices against your own records.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "floe-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "keywords": [
    "mcp",
    "floe",
    "model-context-protocol",
    "ai-agent",
    "reconciliation",
    "outcome-based-pricing",
    "invoice",
    "acceptance-statement"
  ],
  "author": "Floe Labs",
  "repository": {
    "type": "git",
    "url": "https://github.com/Floe-Labs/floe-mcp-server"
  },
  "homepage": "https://www.floefinance.com/aibuyers",
  "bugs": {
    "url": "https://github.com/Floe-Labs/floe-mcp-server/issues"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "express": "^5.2.1",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.3.0",
    "vitest": "^4.1.11"
  }
}
